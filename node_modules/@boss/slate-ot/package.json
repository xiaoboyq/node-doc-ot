{
  "name": "@boss/slate-ot",
  "version": "0.1.15",
  "description": "transform between slate operations for collaboration",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "fuzzer": "ts-node -r esm test/fuzzer.ts",
    "test": "jest --verbose",
    "cov": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuwei77/slate-ot.git"
  },
  "keywords": [
    "slate",
    "ot"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.es.js"
    }
  },
  "lib": "./dist",
  "author": "Wei Liu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liuwei77/slate-ot/issues"
  },
  "homepage": "https://github.com/liuwei77/slate-ot#readme",
  "peerDependencies": {
    "@boss/slate": "^0.78.23-beta"
  },
  "devDependencies": {
    "@boss/slate": "^0.78.23-beta",
    "@types/jest": "^27.4.1",
    "@types/node": "^14.0.6",
    "@types/sharedb": "^1.0.8",
    "@types/slate": "^0.47.7",
    "esm": "^3.2.25",
    "express": "^4.17.1",
    "jest": "^28.1.2",
    "lodash": "^4.17.15",
    "ot-fuzzer": "^1.2.1",
    "sharedb": "^2.2.5",
    "typescript": "^3.9.3",
    "uuid": "^8.1.0",
    "websocket-json-stream": "^0.0.3",
    "ws": "^7.3.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/*.ts"
    ]
  }
}
